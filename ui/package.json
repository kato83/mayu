{
  "name": "mayu",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:ja": "ng serve --configuration=development-ja",
    "copy-docs": "mkdir -p public/docs/docs && cp ../README.md public/docs/ && cp ../README_ja.md public/docs/ && cp ../docs/webhooks.md ../docs/webhooks.ja.md ../docs/nvd-import-comparison.md ../docs/nvd-import-comparison.ja.md ../docs/license-policy-example.md ../docs/license-policy-example.ja.md ../docs/translation.md ../docs/translation.ja.md ../docs/vulnerability-triage.md ../docs/vulnerability-triage.ja.md public/docs/docs/ && cp ../docs/*.jpg ../docs/*.png public/docs/docs/ 2>/dev/null || true",
    "prebuild": "pnpm run copy-docs",
    "build": "ng build",
    "prestart": "pnpm run copy-docs",
    "prestart:ja": "pnpm run copy-docs",
    "pretest": "pnpm run copy-docs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "dependencies": {
    "@angular/cdk": "^22.0.5",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/localize": "^22.0.7",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.12",
    "marked": "^18.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.20",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
