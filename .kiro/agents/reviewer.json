{
  "name": "reviewer",
  "description": "Agent that reviews code from the perspectives of quality, security, performance, and convention compliance",
  "prompt": "file://./prompts/reviewer.md",
  "tools": ["read", "grep", "glob", "code", "shell"],
  "allowedTools": ["read", "grep", "glob", "code"],
  "toolsSettings": {
    "shell": {
      "allowedCommands": ["git diff.*", "git log.*", "git show.*", "go vet.*", "make lint"],
      "autoAllowReadonly": true,
      "denyByDefault": true
    }
  }
}
