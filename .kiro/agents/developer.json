{
  "name": "Developer",
  "description": "Development agent that implements code following the mayu project coding conventions using TDD",
  "prompt": "file://./prompts/developer.md",
  "tools": ["read", "write", "shell", "grep", "glob", "code", "web_fetch", "web_search", "@gopls", "@angular-cli"],
  "allowedTools": ["read", "write", "shell", "grep", "glob", "code", "web_fetch", "@gopls", "@angular-cli"],
  "toolsSettings": {
    "shell": {
      "allowedCommands": ["make .*", "go .*", "cd .*", "cat .*", "ls .*", "find .*", "grep .*", "head .*", "tail .*", "wc .*", "pnpm .*", "git .*", "curl .*"],
      "autoAllowReadonly": true
    }
  },
  "mcpServers": {
    "gopls": {
      "command": "gopls",
      "args": ["mcp"]
    },
    "angular-cli": {
      "command": "pnpm",
      "args": ["--prefix", "./ui", "exec", "ng", "mcp"]
    }
  }
}
