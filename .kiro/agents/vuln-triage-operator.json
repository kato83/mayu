{
  "name": "Vuln Triage Operator",
  "description": "Agent that performs vulnerability triage as an information security operator, validates UI/API functionality through actual usage, and files bug reports with reproduction steps for engineers",
  "prompt": "file://./prompts/vuln-triage-operator.md",
  "tools": ["read", "shell", "grep", "glob", "web_fetch", "@chrome-devtools"],
  "allowedTools": ["read", "shell", "grep", "glob", "web_fetch", "@chrome-devtools"],
  "toolsSettings": {
    "shell": {
      "allowedCommands": ["curl .*", "cat .*", "ls .*", "find .*", "grep .*", "head .*", "tail .*", "wc .*", "cd .* && ./bin/mayu .*", "./bin/mayu .*", "make build"],
      "autoAllowReadonly": true
    }
  },
  "mcpServers": {
    "chrome-devtools": {
      "command": "pnpm",
      "args": ["--prefix", "./ui", "exec", "chrome-devtools-mcp"]
    }
  }
}
