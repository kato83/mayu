    "shell": {
      "autoAllowReadonly": true,
      "denyByDefault": false
    },
    "subagent": {
      "availableAgents": ["researcher", "devils_advocate"],
      "trustedAgents": ["researcher", "devils_advocate"]
    }
  }
}
