{
  "name": "DevOps",
  "description": "Agent that manages CI/CD, Docker, release processes, and infrastructure configuration",
  "prompt": "file://./prompts/devops.md",
  "tools": ["read", "write", "shell", "grep", "glob", "code"],
  "allowedTools": ["read", "write", "shell", "grep", "glob", "code"],
  "toolsSettings": {
    "shell": {
      "allowedCommands": ["make .*", "go .*", "docker .*", "git .*", "cat .*", "ls .*", "find .*", "grep .*", "head .*", "tail .*", "pnpm .*"],
      "autoAllowReadonly": true
    }
  }
}
